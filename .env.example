# Kopier til .env.local for lokal utvikling. Legg de samme verdiene inn i Vercel.
# Commit ALDRI .env eller .env.local.

# Supabase -> Project Settings -> API (eller "Connect"-knappen)
NEXT_PUBLIC_SUPABASE_URL=https://ditt-prosjekt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Anthropic Console -> API Keys. Brukes bare på serveren (ikke NEXT_PUBLIC_).
ANTHROPIC_API_KEY=sk-ant-xxx

# Valgfri. Standard er claude-sonnet-5-5.
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- E-post-import ---
# Supabase -> Project Settings -> API Keys -> Secret key. Bare på serveren.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Google Cloud -> Google Auth Platform -> Clients (Web application)
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx

# Postmark -> Server -> Default Inbound Stream -> Inbound address
POSTMARK_INBOUND_ADDRESS=abc123@inbound.postmarkapp.com
# Lang tilfeldig tekst. Samme verdi står i Postmark sin webhook-URL: ...?key=<verdien>
INBOUND_WEBHOOK_SECRET=lang-tilfeldig-tekst
